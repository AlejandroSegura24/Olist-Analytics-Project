table 'Resumen de Ventas'
	lineageTag: edfadd81-3842-47e5-834c-141a5a566b1a

	measure 'Order Count' = DISTINCTCOUNT('Resumen de Ventas'[order_id])
		formatString: 0
		lineageTag: 29d717f3-4b61-4969-a33c-989479313e4a

	measure Average_Unit_Price =
			
			DIVIDE('Finanzas y Cuotas'[Total Sales], [Order Count], 0)
		lineageTag: f1d9a4d2-8375-41f9-8077-0906e274d9a6

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Variación % Mes Anterior' =
			
			VAR _mesActual =
			    SELECTEDVALUE('Resumen de Ventas'[Mes Numero])
			VAR _ventasActual = 'Finanzas y Cuotas'[Total Sales]
			VAR _ventasAnterior =
			    CALCULATE(
			        'Finanzas y Cuotas'[Total Sales],
			        FILTER(
			            ALL('Resumen de Ventas'),
			            MONTH('Resumen de Ventas'[order_date]) = _mesActual - 1
			        )
			    )
			RETURN
			    IF(
			        NOT ISBLANK(_ventasAnterior) && _ventasAnterior <> 0,
			        DIVIDE(_ventasActual - _ventasAnterior, _ventasAnterior),
			        BLANK()
			    )
		lineageTag: c30e507e-757c-4605-9d79-ae5b8330d62c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column order_id
		dataType: string
		lineageTag: 96f39393-c7cc-4a76-8225-ffc3f1e22b71
