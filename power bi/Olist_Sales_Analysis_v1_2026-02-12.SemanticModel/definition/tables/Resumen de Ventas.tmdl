	column 'Día Numero' = WEEKDAY([order_date],1)
		formatString: 0
		lineageTag: 40b5ea36-6445-4968-af4b-17bd82d43df5
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Día Nombre' = SWITCH([Día Numero],1,"Domingo",2,"Lunes",3,"Martes",4,"Miercoles",5,"Jueves",6,"Viernes",7,"Sábado")
		lineageTag: 786e5cd5-748f-4ce9-b401-59e6ea777c6c
		summarizeBy: none
		sortByColumn: 'Día Numero'

		changedProperty = SortByColumn

		annotation SummarizationSetBy = Automatic

	column 'Mes Numero' = MONTH('Resumen de Ventas'[order_date])
		formatString: 0
		lineageTag: 9f30d570-d7d2-4cac-ad10-c6f8298e4da7
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Mes Nombre' =
			
			SWITCH(
			    MONTH('Resumen de Ventas'[order_date]),
			    1, "Enero",    2, "Febrero",  3, "Marzo",
			    4, "Abril",    5, "Mayo",     6, "Junio",
			    7, "Julio",    8, "Agosto",   9, "Septiembre",
			    10, "Octubre", 11, "Noviembre", 12, "Diciembre"
			)
		lineageTag: e6a9927b-7858-4af6-a59d-16bdf392de4a
		summarizeBy: none
		sortByColumn: 'Mes Numero'

		changedProperty = SortByColumn

		annotation SummarizationSetBy = Automatic

	partition 'Resumen de Ventas' = m
